{
    "name": "roundly-consulting/passkeys-for-laravel",
    "description": "A native WebAuthn / FIDO2 passkey relying party for Laravel — registration and authentication ceremonies with ES256/RS256/EdDSA, zero third-party crypto dependencies.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "passkeys",
        "webauthn",
        "fido2",
        "authentication"
    ],
    "homepage": "https://github.com/roundly-consulting/passkeys-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "roundly-consulting/crypto-for-laravel": "@dev",
        "roundly-consulting/enums-for-laravel": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "ext-sodium": "Enables optional Ed25519 (EdDSA / COSE -8) signature verification."
    },
    "repositories": [
        {
            "type": "path",
            "url": "../crypto-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/crypto-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../enums-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/enums-for-laravel",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Passkeys\\": "src/",
            "RoundlyConsulting\\Passkeys\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Passkeys\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Passkeys\\PasskeysServiceProvider"
            ],
            "aliases": {
                "Passkeys": "RoundlyConsulting\\Passkeys\\Facades\\Passkeys"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
